  .row{margin:0 0 14px}.row label{display:flex;justify-content:space-between;font-size:13px;font-weight:600;margin-bottom:5px}
  .row label .num{color:var(--green);font-family:&quot;Cambria&quot;,Georgia,serif;font-weight:700}
  input[type=range]{width:100%;accent-color:var(--green);height:22px}
  .presets{display:flex;flex-wrap:wrap;gap:6px}
  .presets button{padding:7px 10px;border:1px solid var(--line);background:#fff;border-radius:20px;font-size:12px;cursor:pointer;color:var(--petrol);font-weight:600}
  .presets button:hover{background:var(--tint)}
  .hint{font-size:12px;color:var(--mut);margin-top:12px;line-height:1.5}
  .divider{height:1px;background:var(--line);margin:14px 0}
  .legend{display:flex;gap:14px;font-size:12px;color:var(--mut);margin-top:10px;flex-wrap:wrap}
  .legend i{width:16px;height:3px;display:inline-block;vertical-align:middle;margin-right:5px;border-radius:2px}
&lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;header&gt;
  &lt;div class=&quot;kick&quot;&gt;KFUPM · AE 582 · WEEK 3 — CELESTIAL MECHANICS&lt;/div&gt;
  &lt;h1&gt;Vis‑viva — speed, period &amp;amp; energy vs. altitude&lt;/h1&gt;
  &lt;div class=&quot;eq&quot;&gt;v = &lt;b&gt;√(μ(2/r − 1/a))&lt;/b&gt; · circular &lt;b&gt;√(μ/r)&lt;/b&gt; · escape &lt;b&gt;√(2μ/r)&lt;/b&gt; · energy ε = &lt;b&gt;−μ/2a&lt;/b&gt;&lt;/div&gt;
&lt;/header&gt;
&lt;main&gt;
  &lt;div class=&quot;stage&quot;&gt;
    &lt;canvas id=&quot;cv&quot;&gt;&lt;/canvas&gt;
    &lt;div class=&quot;readouts&quot;&gt;
      &lt;div class=&quot;chip&quot;&gt;&lt;div class=&quot;l&quot;&gt;altitude&lt;/div&gt;&lt;div class=&quot;v&quot; id=&quot;oZ&quot;&gt;—&lt;/div&gt;&lt;/div&gt;
      &lt;div class=&quot;chip petrol&quot;&gt;&lt;div class=&quot;l&quot;&gt;circular v&lt;/div&gt;&lt;div class=&quot;v&quot; id=&quot;oV&quot;&gt;—&lt;/div&gt;&lt;/div&gt;
      &lt;div class=&quot;chip gold&quot;&gt;&lt;div class=&quot;l&quot;&gt;period T&lt;/div&gt;&lt;div class=&quot;v&quot; id=&quot;oT&quot;&gt;—&lt;/div&gt;&lt;/div&gt;
      &lt;div class=&quot;chip&quot;&gt;&lt;div class=&quot;l&quot;&gt;escape v&lt;/div&gt;&lt;div class=&quot;v&quot; id=&quot;oVe&quot;&gt;—&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
  &lt;div class=&quot;panel&quot;&gt;
    &lt;h2&gt;Controls&lt;/h2&gt;
    &lt;div class=&quot;row&quot;&gt;&lt;label&gt;Altitude z (km) &lt;span class=&quot;num&quot; id=&quot;zN&quot;&gt;550&lt;/span&gt;&lt;/label&gt;
      &lt;input type=&quot;range&quot; id=&quot;zS&quot; min=&quot;200&quot; max=&quot;40000&quot; step=&quot;50&quot; value=&quot;550&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;divider&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;presets&quot;&gt;
      &lt;button data-z=&quot;400&quot;&gt;LEO 400&lt;/button&gt;
      &lt;button data-z=&quot;800&quot;&gt;SSO 800&lt;/button&gt;
      &lt;button data-z=&quot;20200&quot;&gt;GNSS&lt;/button&gt;
      &lt;button data-z=&quot;35786&quot;&gt;GEO&lt;/button&gt;
    &lt;/div&gt;
    &lt;div class=&quot;legend&quot;&gt;
      &lt;span&gt;&lt;i style=&quot;background:#57d98a&quot;&gt;&lt;/i&gt;circular speed&lt;/span&gt;
      &lt;span&gt;&lt;i style=&quot;background:#DAC961&quot;&gt;&lt;/i&gt;period&lt;/span&gt;
      &lt;span&gt;&lt;i style=&quot;background:#7fdcff&quot;&gt;&lt;/i&gt;escape speed&lt;/span&gt;
    &lt;/div&gt;
    &lt;div class=&quot;hint&quot;&gt;Higher orbits are &lt;b&gt;slower&lt;/b&gt; yet more energetic (ε = −μ/2a rises toward zero as a grows). Escape speed is always √2 × circular speed at the same radius. GEO is the altitude where the period equals one sidereal day.&lt;/div&gt;
  &lt;/div&gt;
&lt;/main&gt;
&lt;script&gt;
const MU=398600.4418, RE=6378.137, zMax=40000;
const cv=document.getElementById(&#x27;cv&#x27;), ctx=cv.getContext(&#x27;2d&#x27;);
let alt=550, DPR=Math.min(window.devicePixelRatio||1,2), W=10,H=10;
const $=id=&gt;document.getElementById(id);
const vc=z=&gt;Math.sqrt(MU/(RE+z));
const ve=z=&gt;Math.sqrt(2*MU/(RE+z));
const Tc=z=&gt;2*Math.PI*Math.sqrt(Math.pow(RE+z,3)/MU)/60;
function fit(){const r=cv.getBoundingClientRect();W=Math.max(10,r.width);H=Math.max(10,r.height);
  cv.width=W*DPR;cv.height=H*DPR;ctx.setTransform(DPR,0,0,DPR,0,0);draw();}
function draw(){
  ctx.clearRect(0,0,W,H);
  const L=48,R=W-52,T=18,B=H-34;
  ctx.strokeStyle=&#x27;#26323b&#x27;;ctx.lineWidth=1;ctx.strokeRect(L,T,R-L,B-T);
  const X=z=&gt;L+z/zMax*(R-L);
  const vMax=12, Yv=val=&gt;B-val/vMax*(B-T);
  const tMax=1500, Yt=val=&gt;B-Math.min(val,tMax)/tMax*(B-T);
  // GEO marker
  ctx.strokeStyle=&#x27;#3a4a54&#x27;;ctx.setLineDash([3,4]);ctx.beginPath();ctx.moveTo(X(35786),T);ctx.lineTo(X(35786),B);ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle=&#x27;#8fa0aa&#x27;;ctx.font=&#x27;10px &quot;Calibri&quot;,monospace&#x27;;ctx.fillText(&#x27;GEO&#x27;,X(35786)-10,T+11);
  // escape curve
  ctx.strokeStyle=&#x27;#7fdcff&#x27;;ctx.setLineDash([5,4]);ctx.lineWidth=2;ctx.beginPath();
  for(let z=200;z&lt;=zMax;z+=200){const x=X(z),y=Yv(ve(z));z&lt;=200?ctx.moveTo(x,y):ctx.lineTo(x,y);}ctx.stroke();ctx.setLineDash([]);
  // v curve
  ctx.strokeStyle=&#x27;#57d98a&#x27;;ctx.lineWidth=2.6;ctx.beginPath();
  for(let z=200;z&lt;=zMax;z+=200){const x=X(z),y=Yv(vc(z));z&lt;=200?ctx.moveTo(x,y):ctx.lineTo(x,y);}ctx.stroke();
  // T curve
  ctx.strokeStyle=&#x27;#DAC961&#x27;;ctx.lineWidth=2.6;ctx.beginPath();
  for(let z=200;z&lt;=zMax;z+=200){const x=X(z),y=Yt(Tc(z));z&lt;=200?ctx.moveTo(x,y):ctx.lineTo(x,y);}ctx.stroke();
  // marker
  ctx.strokeStyle=&#x27;#e8eef0&#x27;;ctx.setLineDash([2,3]);ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(X(alt),T);ctx.lineTo(X(alt),B);ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle=&#x27;#57d98a&#x27;;ctx.beginPath();ctx.arc(X(alt),Yv(vc(alt)),4,0,7);ctx.fill();
  ctx.fillStyle=&#x27;#7fdcff&#x27;;ctx.beginPath();ctx.arc(X(alt),Yv(ve(alt)),4,0,7);ctx.fill();
  ctx.fillStyle=&#x27;#DAC961&#x27;;ctx.beginPath();ctx.arc(X(alt),Yt(Tc(alt)),4,0,7);ctx.fill();
  ctx.fillStyle=&#x27;#8fa0aa&#x27;;ctx.fillText(&#x27;altitude →&#x27;,R-64,B+22);
  ctx.fillStyle=&#x27;#57d98a&#x27;;ctx.fillText(&#x27;v, v_esc (km/s)&#x27;,L+4,T+11);
  ctx.textAlign=&#x27;right&#x27;;ctx.fillStyle=&#x27;#DAC961&#x27;;ctx.fillText(&#x27;T (min)&#x27;,R-4,T+11);ctx.textAlign=&#x27;left&#x27;;
  const T2=Tc(alt);
  $(&#x27;oZ&#x27;).textContent=Math.round(alt).toLocaleString()+&#x27; km&#x27;;
  $(&#x27;oV&#x27;).textContent=vc(alt).toFixed(2)+&#x27; km/s&#x27;;
  $(&#x27;oT&#x27;).textContent=T2&gt;120?(T2/60).toFixed(2)+&#x27; h&#x27;:T2.toFixed(1)+&#x27; min&#x27;;
  $(&#x27;oVe&#x27;).textContent=ve(alt).toFixed(2)+&#x27; km/s&#x27;;
}
$(&#x27;zS&#x27;).oninput=e=&gt;{alt=+e.target.value;$(&#x27;zN&#x27;).textContent=Math.round(alt).toLocaleString();draw();};
document.querySelectorAll(&#x27;.presets button&#x27;).forEach(b=&gt;b.onclick=()=&gt;{alt=+b.dataset.z;$(&#x27;zS&#x27;).value=alt;$(&#x27;zN&#x27;).textContent=Math.round(alt).toLocaleString();draw();});
new ResizeObserver(fit).observe(cv);fit();
&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;
"></iframe>
  </div>
</section>

<!-- VELOCITY COMPONENTS & FLIGHT-PATH ANGLE -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2 · derivation</div>
    <div class="title">Velocity components &amp; the flight‑path angle</div>
    <div class="accent"></div>
    <div class="eqbox">$$v_r=\dot r,\qquad v_\perp=r\dot\nu=\frac{h}{r},\qquad \tan\gamma=\frac{v_r}{v_\perp}=\frac{e\sin\nu}{1+e\cos\nu}$$</div>
    <div class="steps">
      <div class="s"><span class="k">1</span><span class="m">differentiate $r=\dfrac{p}{1+e\cos\nu}$: $\ \dot r=\dfrac{re\sin\nu}{1+e\cos\nu}\dot\nu$</span></div>
      <div class="s"><span class="k">2</span><span class="m">$\tan\gamma=\dot r/(r\dot\nu)=\dfrac{e\sin\nu}{1+e\cos\nu}$</span><span class="why">$\gamma=0$ at perigee/apogee</span></div>
    </div>
    <div class="note">$\gamma$ is the angle of the velocity above the local horizontal — zero at the apsides (purely tangential), largest near $\nu=90^\circ$. Needed to build $(\mathbf r,\mathbf v)$ from elements (Week 4).</div>
  </div>
</section>

<!-- DEMO: FLIGHT-PATH ANGLE -->
<section class="slide demoslide">
  <div class="inner">
    <div class="dhead"><span class="badge">▶ INTERACTIVE</span><span class="dt">Flight-path angle kinematics — velocity vector breakdown</span></div>
    <iframe title="Flight-path angle kinematics" srcdoc="&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;utf-8&quot;&gt;
&lt;style&gt;
  :root{--green:#008540;--forest:#00573F;--petrol:#003E51;--gold:#DAC961;--tint:#EAF3EE;--ink:#12211B;--mut:#5C6B64;--line:#D9DAE4;}
  *{box-sizing:border-box}html,body{margin:0;height:100%}
  body{font-family:&quot;Calibri&quot;,sans-serif;color:var(--ink);background:linear-gradient(180deg,#f4f8f6,#eef4f1)}
  header{padding:12px 24px 8px;border-bottom:3px solid var(--gold);background:var(--petrol);color:#fff}
  header h1{margin:0;font-family:&quot;Cambria&quot;,serif;font-size:22px}
  header .eq{color:#cfe0e4;font-size:14px;margin-top:2px}
  main{display:grid;grid-template-columns:1fr 300px;gap:16px;padding:16px;max-width:1100px;margin:0 auto}
  .stage{background:#05070f;border-radius:12px;overflow:hidden;min-height:400px;position:relative}
  canvas{display:block;width:100%;height:100%}
  .panel{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px}
  .row{margin:0 0 12px}.row label{display:flex;justify-content:space-between;font-size:13px;font-weight:600;margin-bottom:4px}
  input[type=range]{width:100%;accent-color:var(--green)}
  .readouts{position:absolute;top:10px;left:10px;display:flex;gap:6px;flex-wrap:wrap}
  .chip{background:rgba(255,255,255,.94);border-radius:6px;padding:4px 8px;font-size:12px;font-weight:700}
  .chip span{color:var(--mut);font-weight:400;font-size:10px;text-transform:uppercase;margin-right:4px}
  .hint{font-size:12px;color:var(--mut);margin-top:16px;line-height:1.4}
&lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;header&gt;
  &lt;h1&gt;Velocity components &amp; flight-path angle γ&lt;/h1&gt;
  &lt;div class=&quot;eq&quot;&gt;v splits into radial (v&lt;sub&gt;r&lt;/sub&gt;) and tangential (v&lt;sub&gt;⊥&lt;/sub&gt;) &lt;/div&gt;
&lt;/header&gt;
&lt;main&gt;
  &lt;div class=&quot;stage&quot;&gt;&lt;canvas id=&quot;cv&quot;&gt;&lt;/canvas&gt;
    &lt;div class=&quot;readouts&quot;&gt;
      &lt;div class=&quot;chip&quot; style=&quot;color:#fff;background:#57d98a&quot;&gt;&lt;span style=&quot;color:#12211B&quot;&gt;v total&lt;/span&gt;&lt;b id=&quot;oVt&quot;&gt;&lt;/b&gt;&lt;/div&gt;
      &lt;div class=&quot;chip&quot; style=&quot;color:#fff;background:#4a90d9&quot;&gt;&lt;span style=&quot;color:#12211B&quot;&gt;v_r&lt;/span&gt;&lt;b id=&quot;oVr&quot;&gt;&lt;/b&gt;&lt;/div&gt;
      &lt;div class=&quot;chip&quot; style=&quot;color:#fff;background:#DAC961&quot;&gt;&lt;span style=&quot;color:#12211B&quot;&gt;v_⊥&lt;/span&gt;&lt;b id=&quot;oVp&quot;&gt;&lt;/b&gt;&lt;/div&gt;
      &lt;div class=&quot;chip&quot;&gt;&lt;span&gt;γ&lt;/span&gt;&lt;b id=&quot;oG&quot;&gt;&lt;/b&gt;&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
  &lt;div class=&quot;panel&quot;&gt;
    &lt;div class=&quot;row&quot;&gt;&lt;label&gt;True Anomaly ν &lt;span id=&quot;nuN&quot;&gt;45°&lt;/span&gt;&lt;/label&gt;
      &lt;input type=&quot;range&quot; id=&quot;nuS&quot; min=&quot;0&quot; max=&quot;360&quot; value=&quot;45&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;row&quot;&gt;&lt;label&gt;Eccentricity e &lt;span id=&quot;eN&quot;&gt;0.60&lt;/span&gt;&lt;/label&gt;
      &lt;input type=&quot;range&quot; id=&quot;eS&quot; min=&quot;0&quot; max=&quot;0.85&quot; step=&quot;0.01&quot; value=&quot;0.6&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;hint&quot;&gt;Observe how the total velocity vector (green) splits into the local horizontal v&lt;sub&gt;⊥&lt;/sub&gt; (gold) and radial v&lt;sub&gt;r&lt;/sub&gt; (blue). The angle γ between the local horizontal and the velocity vector is exactly zero at perigee (0°) and apogee (180°).&lt;/div&gt;
  &lt;/div&gt;
&lt;/main&gt;
&lt;script&gt;
const cv=document.getElementById(&#x27;cv&#x27;), ctx=cv.getContext(&#x27;2d&#x27;);
let e=0.6, nu=45*Math.PI/180, a=10000, MU=398600;
let W,H,DPR=Math.min(window.devicePixelRatio||1,2);
function drawArrow(fx,fy,tx,ty,col,w){
  ctx.strokeStyle=col;ctx.fillStyle=col;ctx.lineWidth=w;ctx.beginPath();ctx.moveTo(fx,fy);ctx.lineTo(tx,ty);ctx.stroke();
  const a=Math.atan2(ty-fy,tx-fx);ctx.beginPath();ctx.moveTo(tx,ty);ctx.lineTo(tx-10*Math.cos(a-0.5),ty-10*Math.sin(a-0.5));ctx.lineTo(tx-10*Math.cos(a+0.5),ty-10*Math.sin(a+0.5));ctx.fill();
}
function fit(){const r=cv.getBoundingClientRect();W=r.width;H=r.height;cv.width=W*DPR;cv.height=H*DPR;ctx.setTransform(DPR,0,0,DPR,0,0);draw();}
function draw(){
  ctx.clearRect(0,0,W,H);
  const p=a*(1-e*e);
  const sc=Math.min(W/(a*2.5),H/(a*1.5));
  const X=x=&gt;W/2+(x+a*e)*sc, Y=y=&gt;H/2-y*sc;
  
  // Orbit
  ctx.strokeStyle=&#x27;#33414a&#x27;;ctx.lineWidth=2;ctx.beginPath();
  for(let n=0;n&lt;=Math.PI*2.01;n+=0.05){const r=p/(1+e*Math.cos(n));const x=r*Math.cos(n),y=r*Math.sin(n);n?ctx.lineTo(X(x),Y(y)):ctx.moveTo(X(x),Y(y));}ctx.stroke();
  
  // Earth
  ctx.fillStyle=&#x27;#008540&#x27;;ctx.beginPath();ctx.arc(X(0),Y(0),8,0,7);ctx.fill();
  
  // Sat
  const r=p/(1+e*Math.cos(nu)), sx=r*Math.cos(nu), sy=r*Math.sin(nu);
  ctx.strokeStyle=&#x27;rgba(255,255,255,0.2)&#x27;;ctx.setLineDash([3,3]);ctx.beginPath();ctx.moveTo(X(0),Y(0));ctx.lineTo(X(sx),Y(sy));ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle=&#x27;#fff&#x27;;ctx.beginPath();ctx.arc(X(sx),Y(sy),5,0,7);ctx.fill();
  
  // Vectors
  const h=Math.sqrt(MU*p), vr=(MU/h)*e*Math.sin(nu), vp=(MU/h)*(1+e*Math.cos(nu));
  const vScale=30; // visual scaling for arrows
  const urx=Math.cos(nu), ury=Math.sin(nu);
  const upx=-Math.sin(nu), upy=Math.cos(nu);
  
  const vr_x=urx*vr*vScale, vr_y=ury*vr*vScale;
  const vp_x=upx*vp*vScale, vp_y=upy*vp*vScale;
  const vt_x=vr_x+vp_x, vt_y=vr_y+vp_y;
  
  drawArrow(X(sx),Y(sy),X(sx)+vr_x,Y(sy)-vr_y,&#x27;#4a90d9&#x27;,2); // radial
  drawArrow(X(sx),Y(sy),X(sx)+vp_x,Y(sy)-vp_y,&#x27;#DAC961&#x27;,2); // tangential
  drawArrow(X(sx),Y(sy),X(sx)+vt_x,Y(sy)-vt_y,&#x27;#57d98a&#x27;,3); // total
  
  // Readouts
  const vt=Math.sqrt(vr*vr+vp*vp);
  const gam=Math.atan2(vr,vp)*180/Math.PI;
  document.getElementById(&#x27;oVt&#x27;).innerText=vt.toFixed(2)+&#x27; km/s&#x27;;
  document.getElementById(&#x27;oVr&#x27;).innerText=vr.toFixed(2)+&#x27; km/s&#x27;;
  document.getElementById(&#x27;oVp&#x27;).innerText=vp.toFixed(2)+&#x27; km/s&#x27;;
  document.getElementById(&#x27;oG&#x27;).innerText=gam.toFixed(1)+&#x27;°&#x27;;
}
document.getElementById(&#x27;nuS&#x27;).oninput=e=&gt;{nu=e.target.value*Math.PI/180; document.getElementById(&#x27;nuN&#x27;).innerText=e.target.value+&#x27;°&#x27;; draw();}
document.getElementById(&#x27;eS&#x27;).oninput=e=&gt;{window.e=+e.target.value; document.getElementById(&#x27;eN&#x27;).innerText=window.e.toFixed(2); draw();}
window.onresize=fit; fit();
&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;
"></iframe>
  </div>
</section>


<!-- CIRCULAR ORBITS & THE ORBIT ZOO -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2</div>
    <div class="title">Circular orbits &amp; the altitude ladder</div>
    <div class="accent"></div>
    <div class="cols" style="grid-template-columns:1.25fr 1fr">
      <div>
        <svg class="fig" viewBox="0 0 560 366" role="img" aria-label="Orbit regimes">
          <circle cx="40" cy="330" r="52" fill="#2e5aa8"/>
          <g fill="none" stroke-width="2.4">
            <path d="M 40 210 A 120 120 0 0 1 160 330" stroke="#008540"/>
            <path d="M 40 140 A 190 190 0 0 1 230 330" stroke="#008540" opacity="0.7"/>
            <path d="M 40 92 A 238 238 0 0 1 278 330" stroke="#8A6D00"/>
            <path d="M 40 40 A 290 290 0 0 1 330 330" stroke="#00573F"/>
          </g>
          <path d="M 60 330 C 120 40, 470 20, 500 200" fill="none" stroke="#003E51" stroke-width="2" stroke-dasharray="6 5"/>
          <circle cx="150" cy="250" r="4.5" fill="#008540"/><circle cx="235" cy="250" r="4.5" fill="#008540"/>
          <circle cx="330" cy="250" r="4.5" fill="#8A6D00"/><circle cx="497" cy="196" r="4.5" fill="#003E51"/>
          <text class="svgt g" x="176" y="238">LEO · 7.8 km/s · ~90 min</text>
          <text class="svgt s" x="176" y="200">MEO · 3.9 km/s · ~12 h</text>
          <text class="svgt f" x="176" y="160">GEO · 3.07 km/s · 24 h</text>
          <text class="svgt p" x="300" y="70">HEO / Molniya · e≈0.7</text>
          <text class="svgt ink" x="16" y="356">Earth</text>
        </svg>
        <div class="figcap">Radii not to scale. Higher = larger, more energetic, yet <b>slower</b>.</div>
      </div>
      <div>
        <div class="eqbox" style="font-size:2.1vmin">$$v=\sqrt{\tfrac{\mu}{r}},\quad T=2\pi\sqrt{\tfrac{r^3}{\mu}}$$</div>
        <div class="card"><h3>Set by altitude alone</h3>For a circle, pick the altitude and both $v$ and $T$ are fixed — no other element enters. GEO is the radius where $T=1$ sidereal day.</div>
      </div>
    </div>
  </div>
</section>

<!-- KEPLER LAWS -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2</div>
    <div class="title">Kepler's three laws — now derivable</div>
    <div class="accent"></div>
    <div class="cols" style="grid-template-columns:1fr 1fr 1fr">
      <div class="card g"><h3>1 · Ellipses</h3>Orbit is an ellipse with the central body at one <b>focus</b>.</div>
      <div class="card"><h3>2 · Equal areas</h3>$dA/dt=h/2$ — fast at perigee, slow at apogee.</div>
      <div class="card d"><h3>3 · Periods</h3>$T\propto a^{3/2}$, independent of $e$.</div>
    </div>
    <div class="eqbox">$$T=2\pi\sqrt{\frac{a^{3}}{\mu}},\qquad n=\sqrt{\frac{\mu}{a^{3}}}\ \text{(mean motion)}$$</div>
  </div>
</section>

<!-- DERIV: KEPLER 3 -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2 · derivation</div>
    <div class="title">Deriving Kepler's third law</div>
    <div class="accent"></div>
    <div class="steps">
      <div class="s"><span class="k">1</span><span class="m">$\tfrac{dA}{dt}=\tfrac{h}{2}\Rightarrow A=\tfrac{h}{2}T$ over one period</span><span class="why">Kepler 2</span></div>
      <div class="s"><span class="k">2</span><span class="m">ellipse area $A=\pi a b,\ b=a\sqrt{1-e^2}$</span></div>
      <div class="s"><span class="k">3</span><span class="m">$h=\sqrt{\mu p}=\sqrt{\mu a(1-e^2)}$</span></div>
      <div class="s"><span class="k">4</span><span class="m">$\pi a b=\tfrac{h}{2}T\Rightarrow \boxed{T=2\pi\sqrt{a^3/\mu}}$</span><span class="why">$e$ cancels</span></div>
    </div>
    <div class="note">Two orbits with the same $a$ share a period regardless of $e$ — the basis of formation flying (Week 5). Full derivation in <b>Study Notes §3.2.5</b>.</div>
  </div>
</section>

<!-- HARMONIC LAW / WEIGHING -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2</div>
    <div class="title">The harmonic law — and weighing worlds</div>
    <div class="accent"></div>
    <div class="eqbox">$$T^{2}=\frac{4\pi^{2}}{\mu}\,a^{3}\qquad\Longrightarrow\qquad \mu=\frac{4\pi^{2}a^{3}}{T^{2}},\quad M=\frac{\mu}{G}$$</div>
    <div class="cols">
      <div class="card g"><h3>Compare orbits</h3>About one body the ratio $a^{3}/T^{2}$ is fixed, so a single measured orbit calibrates all others — the "harmony" Kepler sought. On a log–log plot, $\log T$ vs $\log a$ is a line of slope $3/2$.</div>
      <div class="card d"><h3>Weigh the central body</h3>Measure any satellite's $a$ and $T$ and you get $\mu$ — hence the mass. This is how we weigh the Earth, the Sun, Jupiter, and distant stars with planets. <br><b>Check:</b> the Moon ($a=384\,400$ km, $T=27.3$ d) returns $\mu_\oplus\approx3.99\times10^{5}\ \mathrm{km^3/s^2}$.</div>
    </div>
  </div>
</section>

<!-- KEPLER <-> NEWTON EQUIVALENCE -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2</div>
    <div class="title">From Kepler to Newton — and back</div>
    <div class="accent"></div>
    <div class="cols">
      <div class="card g"><h3>Kepler ⟹ inverse‑square</h3><ul class="pts" style="margin-top:.3vmin"><li>Equal areas (2nd law) ⟹ the force is <b>central</b> ($\mathbf h$ conserved).</li><li>An ellipse with the force at a <b>focus</b> ⟹ the force $\propto 1/r^{2}$.</li><li>The harmonic law ⟹ the <b>same</b> constant $\mu$ for every orbit.</li></ul></div>
      <div class="card d"><h3>Inverse‑square ⟹ Kepler</h3>Conversely, $\ddot{\mathbf r}=-\mu\mathbf r/r^{3}$ yields a conic (ellipse when bound), the area law, and $T^{2}\propto a^{3}$ — exactly what we derived this week.</div>
    </div>
    <div class="note">This two‑way implication is Newton's triumph: three empirical rules and one force law are the <b>same statement</b>. Prompted by Halley's question "what curve does an inverse‑square force give?", it launched the <i>Principia</i> — and with it, predictive celestial mechanics.</div>
  </div>
</section>

<!-- COORDINATE FRAMES -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2</div>
    <div class="title">Coordinate frames: ECI &amp; perifocal</div>
    <div class="accent"></div>
    <div class="cols" style="grid-template-columns:1.1fr 1fr">
      <div>
        <svg class="fig" viewBox="0 0 560 360" role="img" aria-label="Coordinate frames">
          <circle cx="150" cy="200" r="10" fill="#2e5aa8"/>
          <line x1="150" y1="200" x2="360" y2="200" stroke="#003E51" stroke-width="2"/><polygon points="360,200 350,195 350,205" fill="#003E51"/>
          <line x1="150" y1="200" x2="150" y2="40" stroke="#003E51" stroke-width="2"/><polygon points="150,40 145,50 155,50" fill="#003E51"/>
          <text class="svgt p" x="366" y="204">Î (Aries ♈)</text><text class="svgt p" x="126" y="40">K̂ (spin axis)</text>
          <ellipse cx="300" cy="200" rx="170" ry="95" fill="none" stroke="#00573F" stroke-width="2.5" transform="rotate(-18 300 200)"/>
          <circle cx="300" cy="200" r="7" fill="#008540"/>
          <line x1="300" y1="200" x2="452" y2="150" stroke="#8A6D00" stroke-width="2"/><polygon points="452,150 441,150 446,159" fill="#8A6D00"/>
          <line x1="300" y1="200" x2="352" y2="90" stroke="#8A6D00" stroke-width="2"/>
          <text class="svgt s" x="456" y="150">P̂ (perigee)</text><text class="svgt s" x="356" y="88">Q̂</text>
          <text class="svgt f" x="196" y="150">orbit plane</text>
        </svg>
        <div class="figcap">ECI (Î,Ĵ,K̂) is inertial, fixed to the stars. Perifocal (P̂,Q̂,Ŵ) is fixed to the orbit, P̂ toward perigee.</div>
      </div>
      <div>
        <div class="card g"><h3>ECI (inertial)</h3>Î → First Point of Aries, K̂ → spin axis. Elements are quoted here so they don't rotate with the Earth.</div>
        <div class="card d"><h3>Perifocal (PQW)</h3>In‑plane frame with P̂ toward perigee. The natural place to write $\mathbf r,\mathbf v$ — then rotate by $\omega,i,\Omega$ into ECI (Week 4).</div>
      </div>
    </div>
  </div>
</section>

<!-- PERIFOCAL r,v -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2</div>
    <div class="title">Position &amp; velocity in the perifocal frame</div>
    <div class="accent"></div>
    <div class="eqbox">$$\mathbf r=\frac{p}{1+e\cos\nu}\big(\cos\nu\,\hat{\mathbf P}+\sin\nu\,\hat{\mathbf Q}\big)$$ $$\mathbf v=\sqrt{\frac{\mu}{p}}\big[-\sin\nu\,\hat{\mathbf P}+(e+\cos\nu)\,\hat{\mathbf Q}\big]$$</div>
    <div class="note">Everything in Lecture 1–2 lives in this plane. The full state in ECI is obtained by the rotation $\mathbf r_{\rm ECI}=R_3(-\Omega)R_1(-i)R_3(-\omega)\,\mathbf r_{\rm PQW}$ — assembled in Week 4.</div>
  </div>
</section>

<!-- POSITION VS TIME -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2</div>
    <div class="title">The problem of time — where is it <i>when</i>?</div>
    <div class="accent"></div>
    <div class="cols">
      <div class="card g"><h3>What we have</h3>$r(\nu)$ gives the shape, and $\varepsilon,h$ the size — but not <b>when</b> the body is at a given $\nu$. Because $\dot\nu=h/r^2$ varies, $\nu(t)$ is nonlinear.</div>
      <div class="card d"><h3>What's coming (Week 4)</h3>The <b>anomalies</b> and <b>Kepler's equation</b> $M=E-e\sin E$ solve $\nu(t)$. Mean motion $n=\sqrt{\mu/a^3}$ from Kepler III is the bridge: $M=n(t-t_p)$.</div>
    </div>
    <div class="note">This closes the two‑body geometry and opens Week 4's descriptive machinery — the six elements and time‑of‑flight.</div>
  </div>
</section>

<!-- WORKED EXAMPLE 1 -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2 · worked example</div>
    <div class="title">Circular‑orbit speed and period</div>
    <div class="accent"></div>
    <div class="cols">
      <div class="card g"><h3>Given</h3>Circular, altitude $h=500$ km, $R_\oplus=6378$ km. <h3 style="margin-top:1.4vmin">Find</h3>$v$ and $T$.</div>
      <div class="card d"><h3>Solution</h3>$r=6878$ km<br>$v=\sqrt{\mu/r}=\sqrt{398600/6878}\approx\mathbf{7.61}$ km/s<br>$T=2\pi\sqrt{r^3/\mu}\approx\mathbf{94.6}$ min</div>
    </div>
  </div>
</section>

<!-- WORKED EXAMPLE 2 -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2 · worked example</div>
    <div class="title">Energy, a and e from a state vector</div>
    <div class="accent"></div>
    <div class="cols">
      <div class="card g"><h3>Given</h3>$r=8000$ km, $v=8.5$ km/s, flight‑path angle $\gamma=20^\circ$. <h3 style="margin-top:1.4vmin">Find</h3>$a,\ h,\ e$.</div>
      <div class="card d"><h3>Solution</h3>
        $\varepsilon=\tfrac12 v^2-\mu/r=-13.70\Rightarrow a=-\mu/2\varepsilon=\mathbf{14\,547}$ km<br>
        $h=rv\cos\gamma=63\,889\Rightarrow p=h^2/\mu=10\,240$ km<br>
        $e=\sqrt{1-p/a}=\mathbf{0.544}$
      </div>
    </div>
    <div class="note">This is the core of the $(\mathbf R,\mathbf V)\to$ elements algorithm completed in Week 4.</div>
  </div>
</section>

<!-- WORKED EXAMPLE 3: HYPERBOLIC -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2 · worked example</div>
    <div class="title">A hyperbolic flyby — $v_\infty$ and turn angle</div>
    <div class="accent"></div>
    <div class="cols">
      <div class="card g"><h3>Given</h3>A probe passes Jupiter ($\mu_J=1.267\times10^{8}\ \mathrm{km^3/s^2}$) at perigee radius $r_p=2R_J=142\,984$ km with $v_\infty=6$ km/s. <h3 style="margin-top:1.2vmin">Find</h3>$e$ and turn angle $\delta$.</div>
      <div class="card d"><h3>Solution</h3>
        $e=1+\dfrac{r_p v_\infty^{2}}{\mu_J}=1+\dfrac{142984\cdot36}{1.267\times10^{8}}=\mathbf{1.041}$<br>
        $\delta=2\sin^{-1}(1/e)=2\sin^{-1}(0.961)=\mathbf{147^\circ}$<br>
        $a=-\mu_J/v_\infty^2=-3.52\times10^{6}$ km
      </div>
    </div>
    <div class="note">The velocity vector rotates by $147^\circ$ in Jupiter's frame — the free redirection that gravity assist exploits (Week 5).</div>
  </div>
</section>

<!-- TLE DEFINITIONS & PARSER -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2</div>
    <div class="title">Real-World Orbit Data: The Two-Line Element Set (TLE)</div>
    <div class="accent"></div>
    <div class="cols">
      <div class="card g"><h3>The Standard Format</h3>A standardized 70-character-per-line format developed by NORAD. It packages the classic 6 Keplerian elements ($i, \Omega, e, \omega, M$, and $n$) into a compact string used universally by tracking systems.</div>
      <div class="card d"><h3>The Epoch</h3>TLEs encode time in a specific format (Year and Day of Year). When importing TLEs into high-fidelity mission design software like GMAT, this epoch is typically converted to standard references, such as the J2000 epoch.</div>
    </div>
    
    <div class="simwrap" style="margin-top:2vmin"><iframe title="TLE Parser" srcdoc="&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;utf-8&quot;&gt;
&lt;style&gt;
  :root{--green:#008540;--forest:#00573F;--tint:#EAF3EE;--ink:#12211B;--line:#D9DAE4;}
  body{font-family:&quot;Calibri&quot;,sans-serif;color:var(--ink);background:#05070f;margin:0;padding:20px;display:flex;flex-direction:column;align-items:center}
  .box{background:#fff;border-radius:12px;padding:20px;width:100%;max-width:800px;box-shadow:0 4px 12px rgba(0,0,0,.2)}
  h3{margin:0 0 10px;color:var(--forest)}
  textarea{width:100%;height:60px;font-family:monospace;font-size:13px;padding:10px;border:1px solid var(--line);border-radius:6px;background:#f9f9f9;resize:none}
  button{margin-top:10px;padding:8px 16px;background:var(--green);color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:700}
  .grid{display:grid;grid-template-columns:repeat(3, 1fr);gap:12px;margin-top:16px}
  .item{background:var(--tint);padding:10px;border-radius:8px;border-left:4px solid var(--green)}
  .item .l{font-size:11px;color:var(--forest);text-transform:uppercase;font-weight:700;margin-bottom:4px}
  .item .v{font-family:monospace;font-size:15px;font-weight:bold}
&lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;div class=&quot;box&quot;&gt;
    &lt;h3&gt;TLE Parser Widget (Try it with ISS)&lt;/h3&gt;
    &lt;textarea id=&quot;tle&quot;&gt;1 25544U 98067A   23277.53489110  .00017124  00000+0  30768-3 0  9997
2 25544  51.6416 308.2838 0005436  66.5204  68.2166 15.50151121418706&lt;/textarea&gt;
    &lt;button onclick=&quot;parse()&quot;&gt;Decode Elements&lt;/button&gt;
    &lt;div class=&quot;grid&quot; id=&quot;out&quot;&gt;
       &lt;!-- Output goes here --&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;script&gt;
function parse(){
  const lines=document.getElementById(&#x27;tle&#x27;).value.split(&#x27;\n&#x27;);
  if(lines.length&lt;2) return;
  const l1=lines[0], l2=lines[1];
  const epoch = l1.substring(18,32).trim();
  const i = l2.substring(8,16).trim();
  const raan = l2.substring(17,25).trim();
  const e = &#x27;0.&#x27; + l2.substring(26,33).trim();
  const argp = l2.substring(34,42).trim();
  const ma = l2.substring(43,51).trim();
  const n = l2.substring(52,63).trim();
  
  document.getElementById(&#x27;out&#x27;).innerHTML = `
    &lt;div class=&quot;item&quot;&gt;&lt;div class=&quot;l&quot;&gt;Inclination (i)&lt;/div&gt;&lt;div class=&quot;v&quot;&gt;${i}°&lt;/div&gt;&lt;/div&gt;
    &lt;div class=&quot;item&quot;&gt;&lt;div class=&quot;l&quot;&gt;RAAN (Ω)&lt;/div&gt;&lt;div class=&quot;v&quot;&gt;${raan}°&lt;/div&gt;&lt;/div&gt;
    &lt;div class=&quot;item&quot;&gt;&lt;div class=&quot;l&quot;&gt;Eccentricity (e)&lt;/div&gt;&lt;div class=&quot;v&quot;&gt;${e}&lt;/div&gt;&lt;/div&gt;
    &lt;div class=&quot;item&quot;&gt;&lt;div class=&quot;l&quot;&gt;Arg of Perigee (ω)&lt;/div&gt;&lt;div class=&quot;v&quot;&gt;${argp}°&lt;/div&gt;&lt;/div&gt;
    &lt;div class=&quot;item&quot;&gt;&lt;div class=&quot;l&quot;&gt;Mean Anomaly (M)&lt;/div&gt;&lt;div class=&quot;v&quot;&gt;${ma}°&lt;/div&gt;&lt;/div&gt;
    &lt;div class=&quot;item&quot;&gt;&lt;div class=&quot;l&quot;&gt;Mean Motion (n)&lt;/div&gt;&lt;div class=&quot;v&quot;&gt;${n} rev/day&lt;/div&gt;&lt;/div&gt;
  `;
}
parse();
&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;"></iframe></div>
  </div>
</section>

<!-- B-STAR AND DRAG -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · Lecture 2</div>
    <div class="title">Beyond the Two-Body Problem: The $B^*$ Drag Term</div>
    <div class="accent"></div>
    <div class="cols">
      <div class="card g"><h3>The Ballistic Coefficient</h3>A physical measure of a satellite's vulnerability to drag: mass vs. cross-sectional area. Imagine throwing a golf ball (a dense "dart") vs. a piece of paper (a "feather" with large solar arrays). The dart pierces the atmosphere; the feather decays rapidly.</div>
      <div class="card d"><h3>The $B^*$ (B-star) Term</h3>Found in line 1 of the TLE, $B^*$ is a modified ballistic coefficient. The analytical SGP4 propagator uses this single pseudo-drag term to estimate orbital decay without having to compute local atmospheric density.</div>
    </div>
    <div class="note"><b>Analytical vs Numerical:</b> SGP4 uses $B^*$ for fast, lightweight estimation. High-fidelity numerical propagators discard the $B^*$ term entirely; instead, they integrate complex environmental models (like MSISE90) based on real-time solar flux and geomagnetic activity to compute true drag.</div>
  </div>
</section>

<!-- WEEK RECAP -->
<section class="slide">
  <div class="inner">
    <div class="kicker">Week 3 · recap</div>
    <div class="title">Two‑body problem — the whole week</div>
    <div class="accent"></div>
    <div class="recap"><ul class="pts">
      <li>The two‑body equation reduces to 1‑D radial motion in $U_{\text{eff}}$; energy sorts the four conics.</li>
      <li>Orbit equation $r=p/(1+e\cos\nu)$ from Binet <i>and</i> the LRL vector.</li>
      <li>Vis‑viva $v^2=\mu(2/r-1/a)$ and $\varepsilon=-\mu/2a$ — speed anywhere, energy from $a$ alone.</li>
      <li>Hyperbolic orbits: $v_\infty^2=-\mu/a=C_3$, turn angle $\sin(\delta/2)=1/e$.</li>
      <li>Real-World formats: TLEs package the 6 elements, while the $B^*$ term estimates drag decay.</li>
      <li>Kepler's three laws derived; frames (ECI, perifocal) and the time problem set up Week 4.</li>
    </ul></div>
  </div>
</section>

<!-- CLOSING -->
<section class="slide dark">
  <div class="inner">
    <div class="kicker">Next — Week 4</div>
    <div class="title" style="font-size:5vmin">Describing orbits &amp; perturbations</div>
    <div class="accent"></div>
    <div class="subtitle">The six elements and the $(\mathbf R,\mathbf V)$ ↔ element algorithm, the anomalies &amp; Kepler's equation, ground tracks — then J₂, precession, atmospheric drag modeling, and special orbits.</div>
  </div>
</section>

<div class="brand">KFUPM · AE 582 · WEEK 3</div>
<div class="pageno" id="pageno"></div>
<div class="nav">
  <button id="prev" aria-label="previous">‹</button>
  <div class="count" id="count">1 / 1</div>
  <button id="next" aria-label="next">›</button>
</div>
<script>
  const slides=[...document.querySelectorAll('.slide')];
  let i=0;
  const prog=document.getElementById('prog'), count=document.getElementById('count'),
        pageno=document.getElementById('pageno'), brand=document.querySelector('.brand');
  function show(n){
    i=Math.max(0,Math.min(slides.length-1,n));
    slides.forEach((s,k)=>s.classList.toggle('active',k===i));
    count.textContent=(i+1)+" / "+slides.length;
    pageno.textContent=(i+1);
    prog.style.width=((i)/(slides.length-1)*100)+"%";
    document.getElementById('prev').disabled=(i===0);
    document.getElementById('next').disabled=(i===slides.length-1);
    const dark=slides[i].classList.contains('dark');
    pageno.style.color=dark?'#9fb6bd':'var(--mut)'; brand.style.color=dark?'#9fb6bd':'var(--mut)';
  }
  document.getElementById('next').onclick=()=>show(i+1);
  document.getElementById('prev').onclick=()=>show(i-1);
  document.addEventListener('keydown',e=>{
    if(e.key==='ArrowRight'||e.key==='PageDown'||e.key===' '){show(i+1);e.preventDefault();}
    else if(e.key==='ArrowLeft'||e.key==='PageUp'){show(i-1);e.preventDefault();}
    else if(e.key==='Home'){show(0);} else if(e.key==='End'){show(slides.length-1);}
    else if(e.key==='f'||e.key==='F'){ if(!document.fullscreenElement)document.documentElement.requestFullscreen(); else document.exitFullscreen(); }
  });
  let sx=null;
  document.addEventListener('touchstart',e=>sx=e.touches[0].clientX,{passive:true});
  document.addEventListener('touchend',e=>{ if(sx===null)return; const dx=e.changedTouches[0].clientX-sx;
     if(Math.abs(dx)>50)show(i+(dx<0?1:-1)); sx=null;},{passive:true});
  show(0);
</script>

</body>
</html>