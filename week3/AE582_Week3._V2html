  main{display:grid;grid-template-columns:1fr 340px;gap:18px;padding:18px 26px 26px;max-width:1300px;margin:0 auto}
  @media(max-width:920px){main{grid-template-columns:1fr}}
  .stage{position:relative;background:#05070f;border-radius:14px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.18);min-height:460px}
  canvas{display:block;width:100%;height:100%}
  .readouts{position:absolute;top:14px;left:14px;display:flex;gap:9px;flex-wrap:wrap;pointer-events:none}
  .chip{background:rgba(255,255,255,.94);border-radius:10px;padding:6px 11px;min-width:80px;box-shadow:0 2px 10px rgba(0,0,0,.3)}
  .chip .l{font-size:10px;letter-spacing:.4px;color:var(--mut);text-transform:uppercase;font-weight:700}
